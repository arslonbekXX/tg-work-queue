TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Where workqueue.db lives. Docker sets this to the mounted volume.
# DATA_DIR=.

# DEBUG, INFO, WARNING or ERROR. Defaults to INFO.
# LOG_LEVEL=INFO

# Touched after every successful getUpdates; the healthcheck reads its age.
# HEARTBEAT_PATH=/tmp/heartbeat
# HEARTBEAT_MAX_AGE_SECONDS=120
